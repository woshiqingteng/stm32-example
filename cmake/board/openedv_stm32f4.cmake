# ALIENTEK openedv STM32F429 (ATK-F429, STM32F429IGTx).
# Device macro, HSE value, memory map and source locations.

include("${CMAKE_CURRENT_LIST_DIR}/../cpu/cortex-m4.cmake")

set(STM32_DEVICE_MACRO STM32F429xx CACHE INTERNAL "" FORCE)
set(STM32_HSE_VALUE   25000000    CACHE INTERNAL "" FORCE)

set(STM32_FLASH_ORIGIN  0x08000000 CACHE INTERNAL "" FORCE)
set(STM32_FLASH_SIZE    0x00100000 CACHE INTERNAL "" FORCE)
set(STM32_RAM_ORIGIN    0x20000000 CACHE INTERNAL "" FORCE)
set(STM32_RAM_SIZE      0x00030000 CACHE INTERNAL "" FORCE)
set(STM32_CCMRAM_ORIGIN 0x10000000 CACHE INTERNAL "" FORCE)
set(STM32_CCMRAM_SIZE   0x00010000 CACHE INTERNAL "" FORCE)

set(STM32_TARGET_DIR     ${CMAKE_SOURCE_DIR}/target/stm32f4 CACHE INTERNAL "" FORCE)
set(STM32_LINKER_SCRIPT  ${STM32_TARGET_DIR}/stm32f429igtx_flash.ld CACHE INTERNAL "" FORCE)
set(STM32_STARTUP_SOURCE ${STM32_TARGET_DIR}/startup_stm32f429igtx.c CACHE INTERNAL "" FORCE)
set(STM32_VECTOR_SOURCE  ${STM32_TARGET_DIR}/vector_stm32f429igtx.c CACHE INTERNAL "" FORCE)
set(STM32_IT_SOURCE      ${STM32_TARGET_DIR}/stm32f4xx_it.c CACHE INTERNAL "" FORCE)
set(STM32_SYSTEM_SOURCE  ${STM32_TARGET_DIR}/system_stm32f4xx.c CACHE INTERNAL "" FORCE)
